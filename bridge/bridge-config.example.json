{
  "server": "https://app.yourpractice.com",
  "token": "dmb_paste-the-key-from-Settings-Imaging-bridges",
  "_appsNote": "Presets (bridge/presets.json) fill in the path, arguments, bridge file and export folder; any field you add overrides the preset. Programs written out in full (like DEXIS and Sidexis below) work as before.",
  "apps": [
    {
      "preset": "romexis"
    },
    {
      "preset": "eaglesoft",
      "command": "D:\\EagleSoft\\Shared Files\\PattersonImaging.exe"
    },
    {
      "id": "dexis",
      "name": "DEXIS",
      "command": "C:\\DEXIS\\DEXIS.exe",
      "args": [
        "/P{patientId}",
        "/N{lastName}, {firstName}",
        "/B{dobMDY}"
      ]
    },
    {
      "id": "sidexis",
      "name": "Sidexis",
      "writeFile": {
        "path": "C:\\Sidexis\\Bridge\\patient.txt",
        "content": "{patientId}\r\n{lastName}\r\n{firstName}\r\n{dobYMD}\r\n{gender}\r\n"
      },
      "command": "C:\\Program Files\\Dentsply Sirona\\SIDEXIS 4\\sidexis4.exe"
    }
  ],
  "watch": [
    {
      "folder": "C:\\DEXIS\\Export",
      "category": "xray",
      "moveTo": "C:\\DEXIS\\Export\\sent"
    },
    {
      "folder": "C:\\Users\\Public\\Pictures\\Intraoral camera",
      "category": "photo"
    }
  ],
  "scanSeconds": 5,
  "sensor": {
    "preset": "tuxedo",
    "exposure": {
      "kvp": 70,
      "ma": 7
    },
    "size": "2",
    "pixelSize": 20
  },
  "_sensorFolderExample": {
    "name": "Sensor",
    "mode": "folder",
    "folder": "C:\\SensorCapture",
    "moveTo": "C:\\SensorCapture\\sent"
  },
  "_sensorJazzExample": {
    "preset": "jazz",
    "device": "Jazz SOLO",
    "exposure": {
      "kvp": 65,
      "ma": 7
    }
  },
  "_sensorTwainExample": {
    "name": "Schick 33",
    "mode": "command",
    "command": "C:\\Program Files\\NAPS2\\NAPS2.Console.exe",
    "args": [
      "-o",
      "{output}",
      "--noprofile",
      "--driver",
      "twain",
      "--device",
      "Schick 33",
      "--force"
    ],
    "extension": "png",
    "timeoutSeconds": 120
  }
}
