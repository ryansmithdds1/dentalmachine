# Required in production: long random string used to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000
# Database: either a SQLite file (single server) or PostgreSQL (recommended for production / several servers).
# Put either on persistent, encrypted, backed-up storage.
DATABASE_PATH=./data/dentalmachine.db
# DATABASE_URL=postgres://user:password@host:5432/dentalmachine
# PG_POOL_SIZE=10

# Several API servers: share live updates, rate limits and background jobs through Redis.
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=dm

# Document storage: local disk by default, or S3-compatible object storage (needed with several servers).
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=            # only for R2 / B2 / MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Public URL used in links sent to patients (reminders, forms, payments).
APP_URL=http://localhost:4000

# Optional integrations — see README "Integrations".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SENDGRID_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOCUMENT_ENCRYPTION_KEY=
UPLOAD_DIR=./data/uploads

# Two-way texting: Twilio webhook signature verification.
# (TWILIO_AUTH_TOKEN above is reused.) Webhook URL: $APP_URL/api/webhooks/twilio/sms

# Electronic insurance through your clearinghouse.
#   manual  = download 837 files and upload them in the clearinghouse portal (default)
#   sandbox = built-in simulated clearinghouse and payer for demos/training
#   sftp    = send claims and pick up 999/277CA/835 files automatically over SFTP
CLEARINGHOUSE=manual
CLEARINGHOUSE_NAME=
EDI_SUBMITTER_ID=
EDI_RECEIVER_ID=
CH_SFTP_HOST=
CH_SFTP_PORT=22
CH_SFTP_USERNAME=
CH_SFTP_PASSWORD=
CH_SFTP_PRIVATE_KEY=     # PEM text or a path to the key file
CH_SFTP_UPLOAD_DIR=/inbound
CH_SFTP_DOWNLOAD_DIR=/outbound
CH_SFTP_ARCHIVE_DIR=     # optional: processed files are moved here
CH_POLL_MINUTES=15
# Real-time eligibility (270/271) and claim status (276/277) over CAQH CORE HTTPS.
CH_REALTIME_URL=
CH_REALTIME_USERNAME=
CH_REALTIME_PASSWORD=
