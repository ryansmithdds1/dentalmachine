# Required in production: long random string used to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000
# SQLite database file. Put it on a persistent, encrypted, backed-up volume.
DATABASE_PATH=./data/dentalmachine.db

# Public URL used in links sent to patients (reminders, forms, payments).
APP_URL=http://localhost:4000

# Optional integrations — see README "Integrations".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SENDGRID_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOCUMENT_ENCRYPTION_KEY=
UPLOAD_DIR=./data/uploads
