{
  "name": "dentalmachine",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud dental practice management software",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm test --workspace server",
    "e2e": "node --test e2e/*.test.mjs",
    "loadtest": "npm run loadtest --workspace server --",
    "lint": "eslint ."
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.56.1"
  }
}
