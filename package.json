{
  "name": "dentalmachine",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud dental practice management software",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:themed": "npm run seed:themed --workspace server",
    "invite": "npm run invite --workspace server --",
    "rotate-keys": "npm run rotate-keys --workspace server",
    "test": "npm test --workspace server",
    "e2e": "node --test e2e/*.test.mjs e2e/workflows/*.test.mjs",
    "loadtest": "npm run loadtest --workspace server --",
    "lint": "eslint .",
    "e2e:workflows": "node --test e2e/workflows/*.test.mjs",
    "e2e:sweep": "node --test e2e/sweep/sweep.test.mjs",
    "e2e:chaos": "node --test --test-concurrency=2 e2e/chaos/*.test.mjs",
    "e2e:journeys": "node --test --test-concurrency=2 e2e/journeys/*.test.mjs",
    "smoke": "node e2e/smoke/live.test.mjs",
    "actions": "node e2e/actions/run.mjs",
    "actions:report": "node e2e/actions/report.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.56.1"
  }
}
